# 复制为 .env 后按实际修改：copy .env.example .env（Windows）
# ------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# 管理口令：修改/删除仍需要它；上线务必改成足够长的随机串
ADMIN_TOKEN=change-me

# 前台免口令新增商户、上传配图：1 开启（默认），0 关闭（新增也会要求口令）
PUBLIC_ADD=1

# MySQL 连接
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=canyin
MYSQL_POOL=10
